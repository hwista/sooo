# Copy this file to .env.production on the deployment host. The real file is
# gitignored. Placeholder values intentionally fail docker:production:verify-env.

# Release identity is baked into server, DMS, and Admin images.
SSOO_RELEASE_SHA=replace-with-the-40-character-release-commit-sha

# PostgreSQL (internal compose network only)
POSTGRES_DB=ssoo_prod
POSTGRES_USER=ssoo
POSTGRES_PASSWORD=replace-with-a-random-database-password
DOCKER_DATABASE_URL=postgresql://ssoo:replace-with-a-random-database-password@postgres:5432/ssoo_prod?schema=public
DOCKER_DMS_DATABASE_URL=postgresql://ssoo:replace-with-a-random-database-password@postgres:5432/ssoo_prod?schema=public

# Public origins and reverse-proxy contract
CORS_ORIGIN=https://admin.example.invalid,https://crm.example.invalid,https://pms.example.invalid,https://dms.example.invalid,https://sns.example.invalid
AUTH_PUBLIC_API_BASE_URL=https://api.example.invalid/api
AUTH_DEFAULT_LOGIN_URL=https://admin.example.invalid/login
# Enable only when the immediate reverse proxy is trusted and overwrites forwarded headers.
AUTH_TRUST_FORWARD_HEADERS=false
AUTH_ALLOW_INSECURE_PRODUCTION_DEFAULTS=false

# Authentication secrets: generate four independent random values of at least 32 characters.
JWT_SECRET=replace-with-an-independent-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-an-independent-random-refresh-secret
AUTH_OAUTH_STATE_SIGNING_SECRET=replace-with-an-independent-random-oauth-state-secret
AUTH_CONFIG_ENCRYPTION_KEY=replace-with-an-independent-random-config-encryption-key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
AUTH_SESSION_COOKIE_NAME=ssoo-session
AUTH_SESSION_COOKIE_DOMAIN=.example.invalid
AUTH_SESSION_COOKIE_SECURE=true
AUTH_SESSION_COOKIE_SAME_SITE=lax
AUTH_SESSION_IDLE_TIMEOUT_MINUTES=30
AUTH_MICROSOFT_OAUTH_STATE_COOKIE_NAME=ssoo-ms-oauth-state

# Password-reset delivery. Use a dedicated SMTP credential; the Admin auth page
# exposes worker readiness, masked recipients, failures, and retry controls.
AUTH_EMAIL_OUTBOX_WORKER_ENABLED=true
AUTH_EMAIL_OUTBOX_INTERVAL_MS=30000
AUTH_EMAIL_OUTBOX_BATCH_LIMIT=20
AUTH_EMAIL_OUTBOX_RUN_ON_START=true
AUTH_EMAIL_SMTP_HOST=smtp.example.invalid
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_SECURE=false
AUTH_EMAIL_SMTP_USERNAME=replace-with-a-dedicated-smtp-user
AUTH_EMAIL_SMTP_PASSWORD=replace-with-a-dedicated-smtp-password
AUTH_EMAIL_FROM_ADDRESS=no-reply@example.invalid

# Browser-facing URLs are compiled into all five Next.js images.
ADMIN_NEXT_PUBLIC_API_URL=https://api.example.invalid/api
CRM_NEXT_PUBLIC_API_URL=https://api.example.invalid/api
PMS_NEXT_PUBLIC_API_URL=https://api.example.invalid/api
DMS_NEXT_PUBLIC_API_URL=https://api.example.invalid/api
SNS_NEXT_PUBLIC_API_URL=https://api.example.invalid/api
DMS_NEXT_PUBLIC_WS_URL=wss://api.example.invalid
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.invalid
NEXT_PUBLIC_CRM_APP_URL=https://crm.example.invalid
NEXT_PUBLIC_PMS_APP_URL=https://pms.example.invalid
NEXT_PUBLIC_DMS_APP_URL=https://dms.example.invalid
NEXT_PUBLIC_SNS_APP_URL=https://sns.example.invalid

# CRM S15 go-live verification reads the URLs and release SHA above. Inject
# CRM_GO_LIVE_ADMIN_LOGIN_ID / CRM_GO_LIVE_ADMIN_PASSWORD from a secret manager
# only for the verifier process; never add those values to this file or input packet.

# DMS durable runtime roots. Create and back up these absolute host directories.
DMS_MARKDOWN_HOST_PATH=/srv/ssoo/documents
DMS_INGEST_HOST_PATH=/srv/ssoo/document-ingest
DMS_STORAGE_LOCAL_HOST_PATH=/srv/ssoo/document-storage/local
DMS_MARKDOWN_ROOT=/var/lib/ssoo/documents
DMS_INGEST_QUEUE_PATH=/var/lib/ssoo/document-ingest
DMS_STORAGE_LOCAL_BASE_PATH=/var/lib/ssoo/document-storage/local
DMS_STORAGE_NAS_BASE_PATH=/mnt/nas/documents

# Launch backup/restore proof. Use a durable backup filesystem distinct from all runtime roots.
DMS_BACKUP_ARCHIVE_ROOT=/srv/ssoo-backups/dms
DMS_BACKUP_ARCHIVE_NAME=replace-with-unique-launch-backup-YYYYMMDDTHHMMSSZ.tar.gz
DMS_BACKUP_RETENTION_DAYS=30

# DMS production Git role. Use SSH or HTTPS without embedded credentials.
DMS_INSTANCE_ENV=prod
DMS_GIT_PROD_REMOTE_URL=ssh://git@git.example.invalid/LSITC_WEB/LSWIKI_DOC.git
DMS_GIT_BOOTSTRAP_REMOTE_URL=
DMS_GIT_BOOTSTRAP_BRANCH=master
DMS_GIT_HTTP_AUTH_SCOPE=
DMS_GIT_HTTP_CREDENTIALS_FILE=
DMS_GIT_PUBLISH_IGNORED_PATH_PREFIXES=launch-smoke/,codex-lock-ui/,codex-lock-probe/,verify-access/

# AI/RAG is an explicit launch decision, never an implicit skip.
# Allowed: exempted_external_provider or provider_ready
DMS_AI_RAG_LAUNCH_MODE=exempted_external_provider

# Optional Azure OpenAI. Leave the whole block empty when AI is not enabled.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DIMENSION=
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_USE_MANAGED_IDENTITY=false
AZURE_MANAGED_IDENTITY_CLIENT_ID=
# Optional approved PEM root CA for TLS-intercepting organization networks.
# Leave empty on networks using the public Web PKI.
SSOO_TLS_CA_CERT_FILE=
